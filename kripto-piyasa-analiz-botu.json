      "typeVersion": 1
    },
    {
      "id": "credentials-sticky-xcodewraith",
      "name": "Gerekli Bilgiler",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -400,
        -100
      ],
      "parameters": {
        "color": 3,
        "width": 320,
        "height": 350,
        "content": "## 🔐 Gerekli Kimlik Bilgileri\n\n### @Chart-img API\n• Token türü: Bearer\n• Grafik API için kullanılır\n• chart-img.com adresinden alın\n\n### @BrowserAI API\n• Token türü: Bearer\n• Web scraping için kullanılır\n• browser.ai adresinden alın\n\n### @OpenRouter API\n• GPT modeli için kullanılır\n• openrouter.ai adresinden alın\n\n### @Telegram API\n• Bot tokenı gerekli\n• @BotFather ile oluşturun"
      },
      "typeVersion": 1
    },
    {
